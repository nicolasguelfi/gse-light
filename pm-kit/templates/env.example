# Keys and settings for the Project Advisor's scripts (gse-light/scripts), in a project-management repository.
# Copy this file to `.env` at the root of the project-management repository and fill the values.
# `.env` is git-ignored and never read by Claude (.claude/settings.json denies it):
# only ../gse-light/scripts/llm_call.py, ../gse-light/scripts/meeting/meeting.sh and ../gse-light/scripts/meeting/transcribe.py read it.
# Generic pattern, nothing project-specific: one variable per vendor (<VENDOR>_API_KEY, optional
# <VENDOR>_BASE_URL when a provider such as OpenRouter is in front, <VENDOR>_MODEL); the vendors
# below are the ones the scripts support today. A project's own keys belong in its product
# repository's `.env`, never here.

# --- Google AI Studio (Gemini) — used by `meeting transcribe --engine gemini`
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenRouter (OpenAI-compatible; one key for many vendors) — text calls only
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# --- Cost estimates: EUR per million tokens, JSON {"model": [input, output]}.
# Overrides the small built-in table of ../gse-light/scripts/llm_call.py. Estimates, never invoices.
LLM_PRICES_JSON=

# --- Active instance (the project's folder in instances/ of this project-management repository)
INSTANCE=                         # empty = the only folder in instances/

# --- Meeting recording (../gse-light/scripts/meeting/meeting.sh)
MEETING_AUDIO_DEVICE=0            # index from `../gse-light/scripts/meeting/meeting.sh devices`
MEETINGS_DIR=                     # empty = instances/<INSTANCE>/meetings; or a path (relative to the root, or absolute)

# --- Transcription (../gse-light/scripts/meeting/transcribe.py)
TRANSCRIBE_ENGINE=local           # local (mlx-whisper / whisper.cpp) | gemini
TRANSCRIBE_LANGUAGE=              # empty = auto; e.g. fr, en
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
WHISPER_CPP_MODEL=                # only for whisper.cpp: path to a ggml model file
