{
  "permissions": {
    "additionalDirectories": ["../gse-light", "../<pm-repo>"],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(./gates.sh:*)",
      "Bash(../gse-light/claude-kit/check.sh:*)",
      "Bash(python3 ../gse-light/scripts/check_docs.py:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(../gse-light/**)",
      "Write(../gse-light/**)",
      "Edit(../<pm-repo>/instances/<instance>/BRIEFING.md)",
      "Write(../<pm-repo>/instances/<instance>/BRIEFING.md)",
      "Bash(git push --force:*)",
      "Bash(git push origin main:*)"
    ]
  }
}
