# <repository name> — local secrets and settings. Copy to `.env` and fill; `.env` is
# git-ignored and never read by Claude (.claude/settings.json denies it). Keys for
# complementary models come from the client organisation through the project lead; the Claude Code
# licence comes from the Project Advisor and needs no key here.
#
# One variable per vendor. A provider in front of several vendors (OpenRouter) is a base
# URL, not new code: code reads these through the project's single model helper.

# --- complementary models (only those a task actually needs)
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- application (filled once the stack is chosen; names are examples)
DATABASE_URL=
# <other settings the CLAUDE.md "Commands" table needs>
