# <repository name> — local secrets and settings. Copy this file to `.env` and fill it; `.env` is
# git-ignored and never read by Claude (.claude/settings.json denies it): only the method's
# scripts read it (../gse-light/scripts/llm_call.py, meeting/meeting.sh, meeting/transcribe.py)
# and the product's own code, through its single model helper. Keys for complementary models
# come from the client organisation through the project lead; the Claude Code licence comes from
# the Project Advisor and needs no key here. One variable per vendor, named <VENDOR>_API_KEY
# (optional <VENDOR>_BASE_URL when a provider sits in front of several vendors, <VENDOR>_MODEL).
# Every comment stands on its own line, above its variable.

# --- complementary models (only those a task actually needs)
# API key of one vendor
# <VENDOR>_API_KEY=
# base URL, only when a provider sits in front of that vendor
# <VENDOR>_BASE_URL=

# --- application
# Filled after the design phase, from the stack and language decision and the secrets
# decision (design decisions #4 stack and language, and #10 secrets, of the kit skill `design-phase`); the names are the ones
# the "Commands" table of CLAUDE.md uses.

# --- the Project Advisor's scripts (../gse-light/scripts): only on his machine; the team leaves these empty

# Google AI Studio (Gemini) — used by `meeting transcribe --engine gemini`
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (OpenAI-compatible; one key for many vendors) — text, and audio for `meeting transcribe --engine openrouter`
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# Cost estimates: EUR per million tokens, JSON {"model": [input, output]}.
# Overrides the small built-in table of ../gse-light/scripts/llm_call.py. Estimates, never invoices.
LLM_PRICES_JSON=

# Meeting recording (../gse-light/scripts/meeting/meeting.sh)
# Index of the audio device, from `../gse-light/scripts/meeting/meeting.sh devices`.
MEETING_AUDIO_DEVICE=0
# Where the meeting folders live. Empty = project/meetings; or a path (relative to the root, or absolute).
MEETINGS_DIR=

# Transcription (../gse-light/scripts/meeting/transcribe.py)
# local (mlx-whisper / whisper.cpp) | gemini | openrouter
# empty = openrouter when OPENROUTER_API_KEY is set, else local
TRANSCRIBE_ENGINE=
# Language of the recording. Empty = auto; e.g. fr, en.
TRANSCRIBE_LANGUAGE=
# Model of the local engine.
WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
# Only for whisper.cpp: path to a ggml model file.
WHISPER_CPP_MODEL=
